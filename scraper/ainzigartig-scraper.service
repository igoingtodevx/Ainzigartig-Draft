[Unit]
Description=Ainzigartig Website Scraper
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/Ainzigartig-Draft-foundation
ExecStart=/home/deploy/Ainzigartig-Draft-foundation/.venv/bin/python -m uvicorn scraper.service:app --host 127.0.0.1 --port 8501
Restart=always
RestartSec=5
EnvironmentFile=/etc/ainzigartig-scraper.env
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
