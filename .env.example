# Public origin used for same-origin checks and canonical references.
PUBLIC_SITE_ORIGIN=https://ainzigartig.vercel.app
# Optional comma-separated additional origins, for controlled previews only.
ALLOWED_ORIGINS=

# Server-side model providers. Never prefix secrets with VITE_.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ANALYZE_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
AI_GATEWAY_CHAT_MODEL=openai/gpt-4o-mini
AI_GATEWAY_ANALYZE_MODEL=openai/gpt-4o-mini
AI_GATEWAY_DOCUMENT_MODEL=openai/gpt-4o-mini
CHAT_ENABLED=true
AI_DEMOS_ENABLED=true

# Required by public AI endpoints in production. Vercel's Upstash integration
# commonly injects KV_*; direct Upstash setups can use UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Weighted account-wide model-call budget per UTC day (default: 500 units).
AI_DAILY_BUDGET_UNITS=500
RATE_LIMIT_KEY_PREFIX=ainzigartig
# For non-Vercel reverse proxies only: set to a header the proxy overwrites.
TRUSTED_CLIENT_IP_HEADER=

# Website analysis requires an explicitly configured HTTPS scraper.
SCRAPER_URL=
SCRAPER_TOKEN=

# Contact remains off until legal/contact data and all delivery values exist.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM=
